{
 "ansible_python_interpreter": "/usr/bin/python3",
 "bench_apply_allowed": true,
 "bench_flasher": "sim",
 "bench_image": "{{ bench_store }}/zephyr/{{ firmware.image }}",
 "bench_scenarios": [
  {
   "name": "both-answer",
   "steps": [
    {
     "board": "zb1",
     "cmd": "kernel version",
     "expect": "^Zephyr version",
     "name": "version"
    },
    {
     "board": "zb2",
     "cmd": "kernel uptime",
     "expect": "^Uptime: [0-9]+ ms",
     "name": "up",
     "within": 5
    },
    {
     "board": "zb1",
     "cmd": "kernel uptime",
     "expect": "^Uptime: [0-9]+ ms",
     "name": "up"
    },
    {
     "board": "zb3",
     "cmd": "settings read string app/version",
     "expect": "^[0-9]+[.][0-9]+$",
     "name": "version"
    },
    {
     "board": "zb4",
     "cmd": "settings read string net/name",
     "expect": "^zb4$",
     "name": "name",
     "within": 5
    }
   ]
  }
 ],
 "bench_sim_run": "/run/user/1000/rxrbench",
 "bench_socket": "{{ bench_sim_run }}/{{ bench_board }}.sock",
 "bench_store": "{{ bench_repo }}/.build/store",
 "bench_tests": [
  {
   "cmd": "kernel version",
   "expect": "^Zephyr version",
   "name": "version"
  },
  {
   "cmd": "kernel uptime",
   "expect": "^Uptime: [0-9]+ ms",
   "name": "uptime"
  }
 ],
 "firmware": {
  "family": "zephyr_settings",
  "image": "zapp-1.0"
 },
 "zephyr": {
  "device_key": "app/key",
  "facts": [
   "app/version",
   "net/name"
  ],
  "secrets": {
   "cert": "tls/cert",
   "psk": "app/psk"
  },
  "settings": {
   "app/psk": "psk-zb3-0123456789abcdef",
   "net/name": "zb3",
   "tls/cert": "MIIBszCCAVmgAwIBAgIUQzb3cert0000000000000000000000000000000000000000"
  }
 }
}

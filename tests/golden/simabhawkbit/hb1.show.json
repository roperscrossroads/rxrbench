{
 "ansible_python_interpreter": "{{ bench_repo }}/venv/bin/python",
 "bench_apply_allowed": true,
 "bench_bundle": "~/.cache/rxrbench/simvm/bundles/update-1.1-sim.raucb",
 "bench_delivery_timeout": 420,
 "bench_delivery_tool": "{{ bench_repo }}/collections/ansible_collections/rxrbench/hawkbit/host/bin/hawkbit_route.py",
 "bench_devreg_tool": "{{ bench_repo }}/devreg/devreg.py",
 "bench_hawkbit": {
  "password": "made-up",
  "url": "http://127.0.0.1:8080",
  "user": "bench"
 },
 "bench_hawkbit_device_url": "http://updates.example.org:8080",
 "bench_hawkbit_token": "made-up-token-for-the-example",
 "bench_health_soak": 10,
 "bench_led_path": "/run/leds/act",
 "bench_tests": [
  {
   "cmd": "rauc status",
   "expect": "boot status: .*good",
   "name": "slot-good"
  },
  {
   "cmd": "grep ' /data ' /proc/mounts",
   "expect": "/data",
   "name": "data-mounted"
  }
 ],
 "bench_wait_good": 180,
 "firmware": {
  "family": "linux_slotguard",
  "image": "sim-ab"
 },
 "linux": {
  "files": {
   "/data/hawkbit/config": {
    "content": "SERVER={{ bench_hawkbit_device_url }}\nCONTROLLER_ID={{ bench_routes.flash.addr }}\nTARGET_TOKEN={{ bench_hawkbit_token }}\nREBOOT_ON_UNHEALTHY=1\n",
    "mode": "600"
   }
  }
 },
 "routes": {
  "flash": "hawkbit"
 }
}

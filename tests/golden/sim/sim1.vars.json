{
 "bench_access_host": "simhost",
 "bench_apply_allowed": true,
 "bench_board": "sim1",
 "bench_board_tag": "native-sim",
 "bench_board_type": {
  "mcu": "native-sim",
  "zephyr_boards": [
   "native_sim"
  ]
 },
 "bench_boot_radio_problems": [],
 "bench_can": [
  "chip"
 ],
 "bench_chip_mac": null,
 "bench_compatible": null,
 "bench_config_via": "shell-tunnel",
 "bench_devreg": "sim1",
 "bench_diag_defaults": [
  {
   "cmd": "meshtastic version",
   "name": "version"
  },
  {
   "cmd": "meshtastic state",
   "name": "state"
  },
  {
   "cmd": "meshtastic status",
   "name": "status"
  },
  {
   "cmd": "meshtastic lora",
   "name": "lora"
  },
  {
   "cmd": "meshtastic resets",
   "name": "resets"
  }
 ],
 "bench_family": "zephyrtastic",
 "bench_family_facts": {
  "led_color": "red",
  "led_mode": "in-use",
  "radio_check_live": true,
  "radio_skip": []
 },
 "bench_family_tasks": "zephyrtastic",
 "bench_flasher": "sim",
 "bench_fw_kind": "port",
 "bench_identity_key": "class",
 "bench_image": "{{ bench_store }}/{{ firmware.family }}/sim-{{ firmware.class }}",
 "bench_key_escrow": "tunnel",
 "bench_kind": "sim",
 "bench_layers": [
  "sim"
 ],
 "bench_layout": "sim",
 "bench_led": "shell",
 "bench_led_color": "red",
 "bench_led_mode": "in-use",
 "bench_locate": "shell",
 "bench_may_transmit": true,
 "bench_mcu": "native-sim",
 "bench_plugin": "rxrbench.mesh",
 "bench_present": true,
 "bench_radio_check_live": true,
 "bench_radio_skip": [],
 "bench_rf_rules": {
  "band_mhz": [
   902.0,
   928.0
  ],
  "max_tx_power": 2,
  "region": "US"
 },
 "bench_routes": {
  "config": {
   "bearer": "usb",
   "can": [
    "shell",
    "flash",
    "config",
    "diag"
   ],
   "host": "simhost",
   "state": "live",
   "synthetic": true
  },
  "diag": {
   "bearer": "usb",
   "can": [
    "shell",
    "flash",
    "config",
    "diag"
   ],
   "host": "simhost",
   "state": "live",
   "synthetic": true
  },
  "flash": {
   "bearer": "usb",
   "can": [
    "shell",
    "flash",
    "config",
    "diag"
   ],
   "host": "simhost",
   "state": "live",
   "synthetic": true
  },
  "shell": {
   "bearer": "usb",
   "can": [
    "shell",
    "flash",
    "config",
    "diag"
   ],
   "host": "simhost",
   "state": "live",
   "synthetic": true
  }
 },
 "bench_secret_kinds": [
  {
   "escrow": true,
   "kind": "identity",
   "origin": "device",
   "tasks": "identity_tunnel",
   "via": "tunnel"
  },
  {
   "escrow": false,
   "kind": "channel_keys",
   "origin": "declared",
   "tasks": "channel_keys"
  },
  {
   "escrow": false,
   "kind": "admin_keys",
   "origin": "declared",
   "tasks": "admin_keys"
  }
 ],
 "bench_sim_console": "pty",
 "bench_sim_device_id": 1,
 "bench_sim_exe": "zephyrtastic/sim-0/zephyr.exe",
 "bench_sim_run": "{{ lookup('ansible.builtin.env', 'RXRBENCH_SIM_RUN') | default('/tmp/rxrbench-sim', true) }}",
 "bench_sim_seed": null,
 "bench_socket": "{{ bench_sim_run }}/{{ bench_board }}.sock",
 "bench_store": "{{ bench_repo }}/.build/store",
 "bench_tests": [
  {
   "cmd": "meshtastic version",
   "expect": "^class:\\s+{{ firmware.class }}\\b",
   "name": "version"
  },
  {
   "cmd": "meshtastic state",
   "expect": "^~S\\{.*\\}\\*[0-9a-f]{4}$",
   "name": "state"
  },
  {
   "cmd": "meshtastic resets",
   "name": "resets",
   "refuse": "WATCHDOG"
  }
 ],
 "bench_update": null,
 "bench_usb_serial": null,
 "bench_via": "console",
 "bench_vocabulary": "meshtastic"
}

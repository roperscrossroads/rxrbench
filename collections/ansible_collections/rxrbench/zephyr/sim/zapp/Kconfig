mainmenu "zapp"

config ZAPP_VERSION
	string "The application's version"
	default "1.0"
	help
	  Written to the setting app/version at every boot, so a bench can read which build a
	  board runs; the image's identity is its hash, this is for the device tests.

# What a build provides: each feature is a `zapp <command>` and a file of its own. The build
# writes the list to zapp-features.txt, and `zapp features` prints it, so a catalog entry's
# `features` come from the build, never typed.

config ZAPP_DIGEST
	bool "zapp digest: the SHA-256 of a stored setting"
	default y
	help
	  A secret is compared by its digest, never crossing the console; a value longer than the
	  settings shell reads back (256 bytes) is checked whole.

config ZAPP_STATE
	bool "zapp state: rxrbench's state line"
	select CRC
	select HWINFO
	help
	  One line, ~S{json}*crc16 (docs/PLUGINS.md "The state line"): the family, the app, its
	  version, the board target and the chip's id.

config ZAPP_LOCATE
	bool "zapp locate: the board's LED, to find it on a bench"
	depends on $(dt_alias_enabled,led0) || $(dt_alias_enabled,led-strip)
	select LED_STRIP if $(dt_alias_enabled,led-strip)
	select GPIO if $(dt_alias_enabled,led0)

config ZAPP_SELFTEST
	bool "zapp test: checks of the board's hardware"
	help
	  `zapp test <name>` prints `test <name> pass <detail>` or `test <name> fail <why>`:
	  settings on flash (write, read back, delete), the entropy source, the die temperature
	  where the chip has a sensor, WiFi when the build has it. A layout binds them as device
	  tests (`bench_tests`).

config ZAPP_BOOTSEL
	bool "rp2 bootsel: into the RP2040's or RP2350's ROM bootloader"
	depends on SOC_FAMILY_RPI_PICO
	help
	  So a bench can write the next image with no button: the picoboot flasher asks for it
	  (`shell:rp2 bootsel`).

config ZAPP_WIFI
	bool "WiFi from settings: wifi/ssid, wifi/psk"
	depends on WIFI && NET_DHCPV4
	help
	  At boot, and on `zapp wifi connect`, joins the network the settings name (a PSK network
	  when wifi/psk is set, an open one otherwise) and takes an address by DHCP. `zapp wifi
	  status` says where it is. The PSK is a secret the layout declares.

config ZAPP_HAWKBIT
	bool "Updates from an Eclipse hawkBit server the device polls"
	depends on HAWKBIT && HAWKBIT_SET_SETTINGS_RUNTIME && HAWKBIT_CUSTOM_DEVICE_ID
	depends on !HAWKBIT_AUTOHANDLER && !HAWKBIT_CONFIRM_IMG_ON_INIT
	select NET_MGMT_EVENT
	help
	  Zephyr's hawkBit client (subsys/mgmt/hawkbit) on a thread of its own: it asks the
	  server, downloads an update into the second slot and reboots into it. The settings
	  zhb/server, zhb/port, zhb/id and zhb/token say which server, under which name and
	  with which token; `zapp hawkbit status` says where it is. An image on its test boot
	  confirms itself after ZAPP_HAWKBIT_CONFIRM_SEC of uptime, and the client asks nothing
	  of the server before that, so the server hears of an update only from an image that
	  came up and stayed up. A fault must reset the device (RESET_ON_FATAL_ERROR, or a
	  watchdog), or an image that hangs on its test boot is never swapped back.

config ZAPP_HAWKBIT_CONFIRM_SEC
	int "Confirm an image on its test boot after this many seconds of uptime"
	depends on ZAPP_HAWKBIT
	default 60

config ZAPP_HAWKBIT_MIN_POLL_SEC
	int "Never ask the server more often than this"
	depends on ZAPP_HAWKBIT
	default 30

config ZAPP_HAWKBIT_FAULT_SEC
	int "For an image made to fail: fault this many seconds into a test boot"
	depends on ZAPP_HAWKBIT
	default 0
	help
	  0: never. Otherwise an image on its test boot (not yet confirmed) panics once it has
	  been up this long, before it would confirm itself: the device resets and MCUboot
	  returns to the image it ran. For a bench to show an update that fails on the device.

config ZAPP_CONSOLE_FLOW_CONTROL
	bool "Flow control on the shell's serial port, turned on once zapp is up"
	depends on SERIAL
	select UART_USE_RUNTIME_CONFIGURE
	help
	  For MCUmgr over the shell on a USB CDC ACM port. The shell transport writes a response a
	  byte at a time with uart_poll_out, faster than a USB packet (64 bytes) leaves, and
	  without flow control the port drops what does not fit: a response longer than one
	  packet (image state, an upload's reply) never arrives. With it, uart_poll_out waits
	  for room. Turned on from main, not in the devicetree: anything printed before the USB
	  stack is enabled (the boot banner, the WiFi driver's firmware line) would wait for a
	  host that cannot connect yet, and the board would never enumerate. Once on, a write to
	  the console waits while no host reads the port; on a bench the board's broker holds it.

source "Kconfig.zephyr"

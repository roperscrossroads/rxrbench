{
 "reply": "(?:^|\\n)(?:  -> ([^\\r]*)\\r\\n|(~S\\{[^\\r\\n]*\\}\\*[0-9a-f]{4})\\r?\\n|(~K[A-Za-z0-9+/]+={0,2}\\*[0-9a-f]{4})\\r?\\n)",
 "secret_prefixes": [
  "password ",
  "set guest.password ",
  "set prv.key ",
  "set bridge.secret "
 ],
 "log_scrub": [
  {
   "pattern": "~K(?P<s>[A-Za-z0-9+/]{8,}={0,2})",
   "label": "key"
  },
  {
   "pattern": "> (?P<s>[0-9a-fA-F]{128})(?![0-9a-fA-F])",
   "label": "key"
  }
 ],
 "blank_reply": "  -> Unknown command\\r?\\n"
}

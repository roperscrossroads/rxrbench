# rxrbench settings: copy to .env (gitignored). `just` loads it; tools started outside just
# (the relay's timer, bare pytest) load it themselves (module_utils/site.py). Every value is
# optional; a path may be absolute or relative to this repository, ~ is expanded.

# ---- where the site is (CONTRIBUTING.md#public-and-private) ---------------------------------------------
#RXRBENCH_SITE=site                        # the site: layouts, registry, facts, secrets
#DEVREG_REGISTRY=site/registry.yaml        # the device registry (devreg reads the same name)
#RXRBENCH_FACTS=site/facts                 # survey facts, one file per device
#RXRBENCH_PLUGINS=                         # plugin collections to load, comma-separated, instead of <site>/plugins.yml

# ---- the plug relay (tools/plug_relay.py, roles/default_install/tasks/relay.yml) ------------
#RXRBENCH_BENCH_NTFY=https://ntfy.example.org/bench   # a plug / unplug notification per device
#RXRBENCH_BUS_SEND=/path/to/send           # a command posting a summary: <send> <sender> all <subject>, body on stdin
#RXRBENCH_BUS_SENDER=rxrbench-plug         # the sender name it posts as
#RXRBENCH_LOCATION_DIR=~/.local/state/rxrbench   # where the relay keeps its state, the location index the layouts read
#RXRBENCH_HOST_STATE=~/rxrbench/state      # a bench host's state as its flashers and a relay on the same machine read it (the watcher's snapshot, busy marks)
#RXRBENCH_SYSFS_USB=/sys/bus/usb/devices   # where a bench host that is this machine is read live for the layouts

# ---- enrolling and labelling -----------------------------------------------------------------
#RXRBENCH_OWNER=                           # `owner:` written into new registry entries by just enroll

# ---- the workstation ---------------------------------------------------------------------------
#USBIPD=usbipd.exe                         # the usbipd command that attaches USB devices to a WSL workstation

# ---- just debug (JTAG on an ESP32-S3 over its console cable) ----------------------------------
#RXRBENCH_GDB=/opt/toolchains/xtensa-esp32s3-elf/bin/xtensa-esp32s3-elf-gdb   # the workstation's GDB for the chip
#RXRBENCH_OPENOCD=~/openocd                # an OpenOCD tree ON THE BENCH HOST (bin/, share/)

# ---- the simulated bench (sim/, just sim-up) ---------------------------------------------------
#RXRBENCH_SIM_RUN=/tmp/rxrbench-sim        # sockets and logs of the simulated boards
#RXRBENCH_SIM_EXE=                         # a native_sim image to run instead of the built one
#RXRBENCH_FIRMWARE_TREE=                   # a firmware worktree the recipe tests compare the catalog with

# ---- the bench on a PC (docs/SIMULATED.md: just sim-zephyr-build, sim-zephyr-up, sim-host-*) -----
#RXRBENCH_ZEPHYR_WORKSPACE=                # a west workspace holding a Zephyr: where tools/zephyr_sim.py builds
# The toolchain west builds with. Unset, each tool takes its own: tools/zephyr_sim.py `host`
# (this machine's gcc, for native_sim), tools/zephyr_qemu.py `zephyr` (the SDK's Arm toolchain,
# for the emulated MCU). Set it only to force one toolchain on both.
#ZEPHYR_TOOLCHAIN_VARIANT=
#RXRBENCH_NUTTX_WORKSPACE=                 # a directory holding nuttx/ and apps/: where tools/nuttx_sim.py builds
#ZEPHYR_SDK_INSTALL_DIR=                   # the Zephyr SDK (its Arm toolchain): tools/zephyr_qemu.py builds the emulated MCU with it
#RXRBENCH_VMHOST_DIR=~/.cache/rxrbench/vmhost   # the simulated bench host's image, keys and instances

# ---- cards on a bench host --------------------------------------------------------------------
#RXRBENCH_CARD_KIT=                        # the card-writing kit's write-card.sh (its path), for just card

# A firmware catalog entry may name the variable holding a token for a private release or
# package source (`token_env:` in <site>/catalog/firmware.yml); set that variable here too.

# Directories of console rules the serial broker reads besides the dialects.d beside it
# (colon-separated). Set by the simulated bench and the tests, which run the broker from the
# source tree; on a bench host the role copies the plugins' rules beside the broker.
#RXRBENCH_DIALECTS=

# Where a bench host's device locks live: one directory for every tool that locks a board or
# the Bluetooth adapter (devreg/devlock.py, the serial broker, uf2_flash, xiao_otafix).
# Default: $XDG_RUNTIME_DIR/devlock, else /run/user/<uid>/devlock.
#DEVLOCK_DIR=

# host/bin/uf2_flash.py (a board through a UF2 bootloader's drive; runs on a bench host)
# Board catalogs it reads, later over earlier, colon-separated.
#UF2_BOARDS=~/rxrbench/catalog/boards.yml:~/rxrbench/catalog/site/boards.yml
# A board's type when the registry has no policy.board_tag for it (same as --type).
#UF2_BOARD_TYPE=
# How a running app is brought to UF2 mode: auto (the board type's touch, else ask the app) or
# manual (wait while someone does what the type's uf2.manual says).
#UF2_ENTER=auto
# How a running app is asked (a family's shell command, or an app's own tool) is not a setting:
# the flasher hands it over (UF2_ENTERS, with UF2_RUNS when it read what the board runs). Run by
# hand, the tool can be told which family's way to use, when the app could be either of two
# families' firmware (a layout says it with bench_uf2_enter_as; docs/ARCHITECTURE.md#entering-uf2-mode).
#UF2_ENTER_AS=
# Seconds UF2_ENTER=manual waits for the drive.
#UF2_MANUAL_WAIT=90
# Where adafruit-nrfutil is, when it is not on PATH or in the default install's venv.
#UF2_NRFUTIL=

# Commit the facts directory after a run that wrote facts (survey, boot, an apply that installed
# into a slot), as one `chore(facts)` commit, when the facts live in a git work tree and nothing
# else in it is dirty. Off by default: a facts directory is never committed behind a site's back.
# Read by tools/facts_commit.py.
#RXRBENCH_FACTS_COMMIT=1

# RXRBENCH_ROOT: the tool's root, where .env, site.example/ and a relative RXRBENCH_SITE are
# found. Default: the checkout the core collection sits in. Set it in the environment, not here
# (this file is found through it); needed only when core is installed apart from the checkout.
#RXRBENCH_ROOT=
